# Copy this file to .env before starting Docker Compose.
# Example: cp .env.example .env

# Initial password for the "三翼青融媒体中心" super administrator.
# Required on first deployment; store only in the server-side .env file.
ACTIVITY_SUPERADMIN_NAME=三翼青融媒体中心
ACTIVITY_SUPERADMIN_PASSWORD=replace-with-a-long-random-password
# Ordinary organization accounts. Keep this JSON on one line. Account names
# are also used as the default organizer names in the activity editor.
ACTIVITY_ADMIN_ACCOUNTS_JSON={"三翼":"replace-with-another-long-password","示例部门":"replace-with-a-third-long-password"}
# Migration only: if the new password is unset, an existing value can bootstrap
# the super account once. This is no longer accepted as an API bearer token.
ACTIVITY_ADMIN_TOKEN=

# Allowed web origin for the activity administration site.
# Use * temporarily, or replace it with the deployed administration URL.
ACTIVITY_ADMIN_ORIGIN=https://gong-admin.mumuzhi.cloud
# Gong AI model gateway. Never commit real values.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4.1-flash

# 32-byte base64/hex deployment secret for encrypted provider sessions.
SESSION_VAULT_MASTER_KEY=

# Show student numbers in self-hosted diagnostic logs. Disable before sending
# logs to any third-party service.
LOG_ACCOUNT_IDS=true

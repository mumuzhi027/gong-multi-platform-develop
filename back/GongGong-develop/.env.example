# Copy this file to .env before starting Docker Compose.
# Example: cp .env.example .env

# Token entered on the activity administration login page.
# Replace this placeholder with a long, random secret.
ACTIVITY_ADMIN_TOKEN=replace-with-a-long-random-token

# Allowed web origin for the activity administration site.
# Use * temporarily, or replace it with the deployed administration URL.
ACTIVITY_ADMIN_ORIGIN=https://gong-admin.mumuzhi.cloud

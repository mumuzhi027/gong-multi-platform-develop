# Replace domain, root and certificate paths with the actual deployment values.
server {
    listen 80;
    server_name gong.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name gong.example.com;
    ssl_certificate /etc/letsencrypt/live/gong.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gong.example.com/privkey.pem;
    root /var/www/gong-pwa;
    index index.html;

    location /api/ {
        proxy_pass http://101.43.27.78:8000/;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
        add_header Cache-Control "no-store" always;
    }
    # Use the same legal-document web service as the native app.
    location /web/ {
        proxy_pass http://101.43.27.78:8000/;
        proxy_set_header Host $proxy_host;
    }
    location = /sw.js {
        default_type application/javascript;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Service-Worker-Allowed "/" always;
        try_files $uri =404;
    }
    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }
    location = /index.html {
        add_header Cache-Control "no-cache" always;
    }
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }
    location /static/ {
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }
    location /pwa/ {
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }
    location / { try_files $uri $uri/ /index.html; }
}

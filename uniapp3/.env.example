# Web uses a same-origin proxy by default, avoiding HTTP mixed content and CORS.
VITE_H5_API_BASE_URL=/api
VITE_H5_WEB_BASE_URL=/web
# Rewrite absolute poster URLs saved by the existing backend.
VITE_BACKEND_PUBLIC_ORIGIN=http://101.43.27.78:8000
# Vite and local production preview only; production uses deploy/nginx.conf.example.
GONG_API_PROXY_TARGET=http://101.43.27.78:8000
GONG_WEB_PROXY_TARGET=http://101.43.27.78:8000
